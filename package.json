{
  "name": "scheduling-app",
  "version": "1.0.0",
  "description": "Voice-powered scheduling app with VAPI and Google Calendar",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "auth": "ts-node src/scripts/auth.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e-ui": "playwright test --ui"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "jest": "^30.4.1",
    "nodemon": "^3.0.2",
    "playwright": "^1.59.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}